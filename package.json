{
  "name": "github-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "dev:worker": "wrangler dev --config wrangler.worker.toml --port 8789",
    "build:worker": "wrangler deploy --config wrangler.worker.toml --dry-run --outdir output/worker-preview",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
